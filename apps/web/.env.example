# PostHog client/server error tracking and build-time source map uploads
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# POSTHOG_PROJECT_ID=
# POSTHOG_API_KEY=

# Sanity Content Lake and embedded Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=bt057kcd
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-10
NEXT_PUBLIC_SANITY_STUDIO_URL=/admin/studio
NEXT_PUBLIC_SANITY_PREVIEW_URL=/
# SANITY_API_READ_TOKEN=

# Optional frozen archive for /tailwind-migration/reference/ assets only.
# Export these in the shell too when running reference CLI commands.
# See docs/references/legacy-reference.md. Both paths must be absolute.
# DFN_LEGACY_REFERENCE_REPO=/absolute/path/to/dfn-web-legacy-reference
# LEGACY_SITE_REFERENCE_ROOT=/absolute/path/to/alternative/site
