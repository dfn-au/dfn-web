# PostHog client/server error tracking and build-time source map uploads
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# POSTHOG_PROJECT_ID=
# POSTHOG_API_KEY=

# Sanity Content Lake and embedded Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=bt057kcd
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-10
NEXT_PUBLIC_SANITY_STUDIO_URL=/admin/studio
NEXT_PUBLIC_SANITY_PREVIEW_URL=/
# SANITY_API_READ_TOKEN=

# Newsletter bot protection: create a Managed widget in Cloudflare Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames (no scheme or port), matching the widget settings.
# TURNSTILE_ALLOWED_HOSTNAMES=dfn.org.au,dfn.org.nz
