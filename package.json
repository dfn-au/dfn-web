{
  "name": "dfn-web",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=11.6.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "format": "pnpm --filter web format",
    "check": "pnpm --filter web check",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:parity": "node --test scripts/style-parity/*.test.mjs",
    "test:watch": "pnpm --filter web test:watch",
    "reference:serve": "node docs/references/legacy-site/serve.mjs",
    "reference:tailwind": "node scripts/style-parity/build-tailwind.mjs",
    "reference:parity": "pnpm reference:tailwind && node scripts/style-parity/cli.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1"
  }
}
